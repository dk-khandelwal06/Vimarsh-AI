# Vimarsh.AI Environment Configuration
# SANGYAN Hackathon 2026 - Digital Fraud & Scam Resilience

# Google Gemini API Key (Required for live multimodal analysis & chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Active Model (Default: gemini-3.8-flash for fast reasoning & vision)
GEMINI_MODEL=gemini-3.8-flash

# Optional Indic Speech / NLP Integration (Sarvam AI)
SARVAM_API_KEY=

# Optional Hugging Face Inference Token
HUGGINGFACE_API_TOKEN=

# App Environment
NEXT_PUBLIC_APP_NAME="Vimarsh.AI"
NEXT_PUBLIC_APP_TAGLINE="Interrupting Fraud with Intelligent Deliberation"
NEXT_PUBLIC_HACKATHON_TRACK="Track A: Digital Fraud & Scam Resilience"
